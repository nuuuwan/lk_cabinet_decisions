    "num": "6",
    "date_str": "2024-07-22",
    "description": "\u0db8\u0dc4\u0dbb\u0d9c\u0db8, \u0dad\u0dbd\u0db4\u0dad\u0dca\u0db4\u0dd2\u0da7\u0dd2\u0dba, \u0db1\u0dc0 \u0dbb\u0ddd\u0dc4\u0dbd \u0db4\u0dcf\u0dbb\u0dda \u0db4\u0dd0\u0dbb\u0dab\u0dd2 \u0d87\u0dc5 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0d89\u0da9\u0db8\u0dca \u0d9a\u0ddc\u0da7\u0dc3\u0dca \u0db1\u0dcf\u0d9c\u0dbb\u0dd2\u0d9a \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dba \u0dc0\u0dd9\u0dad \u0db4\u0dc0\u0dbb\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8",
    "url_metadata": "https://www.cabinetoffice.gov.lk/cab/index.php?option=com_content&view=article&id=16&Itemid=49&lang=si&dID=12687",
    "lang": "si",
    "decision_details_title": "2024-07-22 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0db8\u0dab\u0dca\u0da9\u0dbd \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0db4\u0dd2\u0dbd\u0dd2\u0db6\u0db3 \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dc1\u0dba (\u0db8\u0dd3\u0dbd\u0d9c \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8\u0dda\u0daf\u0dd3 \u0dc3\u0db8\u0dca\u0db8\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0)",
    "decision_details_body": "- \u0db8\u0dc4\u0dbb\u0d9c\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dbd\u0dda\u0d9a\u0db8\u0dca \u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dba\u0dda \u0dad\u0dbd\u0db4\u0dad\u0dca\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dba\u0dda \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0dc4\u0dd9\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca 27.5\u0d9a \u0d89\u0da9\u0db8\u0dca \u0d9a\u0ddc\u0da7\u0dc3\u0d9a\u0dca 1984 \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0dda\u0daf\u0dd3 \u0db1\u0dcf\u0d9c\u0dbb\u0dd2\u0d9a \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dba \u0dc0\u0dd9\u0dad \u0db4\u0dc0\u0dbb\u0dcf \u0daf\u0dd3 \u0d87\u0dad. \u0d91\u0dc4\u0dd9\u0dad\u0dca, \u0d91\u0d9a\u0dd3 \u0d89\u0da9\u0db8\u0dda \u0db8\u0dc4\u0dbb\u0d9c\u0db8, \u0dad\u0dbd\u0db4\u0dad\u0dca\u0db4\u0dd2\u0da7\u0dd2\u0dba, \u0db1\u0dc0 \u0dbb\u0ddd\u0dc4\u0dbd \u0db4\u0dcf\u0dbb\u0dda \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0daf\u0dd0\u0db1\u0da7\u0db8\u0dad\u0dca \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0db6 \u0d87\u0dad\u0dd2 \u0db4\u0dd0\u0dbb\u0dab\u0dd2 \u0d87\u0dc5 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0daf\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0db1 \u0d89\u0da9\u0db8\u0dca \u0d9a\u0ddc\u0da7\u0dc3\u0dca \u0db1\u0dcf\u0d9c\u0dbb\u0dd2\u0d9a \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dba \u0dc0\u0dd9\u0dad \u0dc0\u0dd2\u0db0\u0dd2\u0db8\u0dad\u0dca\u0dc0 \u0db4\u0dd0\u0dc0\u0dbb\u0dd3 \u0db1\u0ddc\u0db8\u0dd0\u0dad. \u0d92 \u0d85\u0db1\u0dd4\u0dc0, \u0d91\u0db8 \u0d89\u0da9\u0db8\u0dda \u0db4\u0dd0\u0dbb\u0dab\u0dd2 \u0d87\u0dc5 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0daf\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0db1 \u0d89\u0da9\u0db8\u0dca \u0d9a\u0ddc\u0da7\u0dc3\u0dca \u0db1\u0dcf\u0d9c\u0dbb\u0dd2\u0d9a \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dba \u0dc0\u0dd9\u0dad \u0d9c\u0dcf\u0dc3\u0dca\u0dad\u0dd4 \u0d85\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0d9a\u0dd2\u0db1\u0dca \u0dad\u0ddc\u0dbb\u0dc0 \u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0dca \u0daf\u0dd3\u0db8\u0db1\u0dcf \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0d9a\u0dca \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0db4\u0dc0\u0dbb\u0dcf \u0daf\u0dd3\u0db8 \u0db4\u0dd2\u0dab\u0dd2\u0dc3 \u0db1\u0dcf\u0d9c\u0dbb\u0dd2\u0d9a \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0dc4\u0dcf \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba\u0dad\u0dd4\u0db8\u0dcf \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dc5 \u0dba\u0ddd\u0da2\u0db1\u0dcf\u0dc0 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d85\u0db1\u0dd4\u0db8\u0dad \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3."
