    "description": "\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0dbb\u0da2\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dad\u0dca \u0db4\u0dd6\u0da2\u0db1\u0dd3\u0dba \u0dc0\u0db1\u0dca\u0daf\u0db1\u0dcf \u0d9c\u0db8\u0db1\u0d9a\u0dca \u0dbd\u0dd9\u0dc3 \u0dc3\u0db6\u0dbb\u0dd2\u0db8\u0dbd\u0ddb \u0dc0\u0db1\u0dca\u0daf\u0db1\u0dcf \u0d9c\u0db8\u0db1 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dc1\u0dba\u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc4\u0dcf \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dc3\u0dd0\u0dbd\u0dc3\u0dd3\u0db8",
