    "description": "\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf\u0dc0\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0d9a\u0dcf \u0dbb\u0ddd\u0d9c\u0dd3\u0db1\u0dca \u0d8b\u0daf\u0dd9\u0dc3\u0dcf \u0d85\u0db0\u0dd2 \u0db6\u0dbd \u0dc0\u0dd2\u0d9a\u0dd2\u0dbb\u0dab \u0dc1\u0d9a\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0dc4\u0dd2\u0dad \u0d8b\u0dc3\u0dc3\u0dca \u0d9c\u0dd4\u0dab\u0dad\u0dca\u0dc0\u0dba\u0dd9\u0db1\u0dca \u0dba\u0dd4\u0dad\u0dca \u0dc0\u0dd2\u0d9a\u0dd2\u0dbb\u0dab \u0da0\u0dd2\u0d9a\u0dd2\u0dad\u0dca\u0dc3\u0d9a \u0d8b\u0db4\u0d9a\u0dbb\u0dab \u0dc3\u0dd0\u0db4\u0dba\u0dd3\u0db8",
