    "description": "\u0db8\u0dd9\u0dbb\u0db4\u0db1\u0db8\u0dca \u0d91\u0db1\u0dca\u0db1\u0dad\u0dca \u0d9c\u0dca\u200d\u0dbb\u0dd1\u0db8\u0dca 1\u0db1\u0dca \u0dc0\u0dba\u0dbd\u0dca 900,000\u0d9a\u0dca \u0dc3\u0dd0\u0db4\u0dba\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba",
