    "date_str": "2017-07-04",
    "description": "Construction of the Accident & Emergency Treatment Unit at the Teaching Hospital - Kandy",
    "url_metadata": "https://www.cabinetoffice.gov.lk/cab/index.php?option=com_content&view=article&id=16&Itemid=49&lang=en&dID=7893",
