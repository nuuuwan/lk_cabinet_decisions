    "description": "\u0d87\u0dc3\u0dca\u0db6\u0dd0\u0dc3\u0dca\u0da7\u0ddd\u0dc3\u0dca \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba, \u0db7\u0dcf\u0dc0\u0dd2\u0dad\u0dba \u0dc3\u0dc4 \u0d87\u0dc3\u0dca\u0db6\u0dd0\u0dc3\u0dca\u0da7\u0ddd\u0dc3\u0dca \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u0d85\u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dca\u200d\u0dba \u0d86\u0db1\u0dba\u0db1\u0dba -",
