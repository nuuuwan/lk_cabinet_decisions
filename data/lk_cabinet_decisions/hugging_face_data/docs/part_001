    "decision_details_body": "- \u0db6\u0dda\u0dc3\u0dca\u0dbd\u0dba\u0dd2\u0db1\u0dca \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba\u0dda \u0d9a\u0dd0\u0dbd\u0dab\u0dd2\u0dad\u0dd2\u0dc3\u0dca\u0dc3 \u0dc0\u0da7\u0dbb\u0dc0\u0dd4\u0db8\u0dda \u0dc3\u0dd2\u0da7 \u0d9a\u0db1\u0dad\u0dca\u0dad \u0dc0\u0da7\u0dbb\u0dc0\u0dd4\u0db8 \u0daf\u0d9a\u0dca\u0dc0\u0dcf (\u0d9a\u0dd2.\u0db8\u0dd3. 0.00 - \u0d9a\u0dd2.\u0db8\u0dd3. 4.80) \u0d9a\u0ddc\u0da7\u0dc3 \u0db0\u0dcf\u0dc0\u0db1 \u0db8\u0d82\u0dad\u0dd3\u0dbb\u0dd4 \u0dc4\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0dba\u0dd4\u0dad\u0dca \u0daf\u0dca\u0dc0\u0dd2\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dae\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0dc3\u0db8\u0db1\u0dca\u0dc0\u0dd2\u0dad \u0dc0\u0dda. \u0dc0\u0da9\u0dcf \u0dc4\u0ddc\u0db3 \u0dc3\u0dda\u0dc0\u0dba\u0d9a\u0dca \u0dc3\u0dd0\u0dbd\u0dc3\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0db8\u0dd9\u0db8 \u0d9a\u0ddc\u0da7\u0dc3\u0dd9\u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db8\u0dad\u0dd4\u0db4\u0dd2\u0da7 \u0db1\u0dd0\u0dc0\u0dad \u0dc3\u0dd0\u0d9a\u0dc3\u0dd3\u0db8 \u0d9a\u0da9\u0dd2\u0db1\u0db8\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u0dc0\u0dd3 \u0dad\u0dd2\u0db6\u0dda. \u0db8\u0dda \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc0 \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \t\u0dc0\u0dbb\u0dcf\u0dba \u0dc4\u0dcf \u0db8\u0dc4\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0dc0\u0dc1\u0dba\u0dd9\u0db1\u0dca \u0d85\u0dad\u0dd2\u0d9c\u0dbb\u0dd4 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d89\u0dc4\u0dad \u0dba\u0ddd\u0da2\u0db1\u0dcf\u0dc0 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d85\u0db1\u0dd4\u0db8\u0dad \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3."
  },
