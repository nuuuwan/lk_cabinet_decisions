    "description": "\u0da7\u0dd9\u0db1\u0dd9\u0d9a\u0dca\u0da7\u0dd2\u0db4\u0dca\u0dbd\u0dda\u0dc3\u0dca \u0d91\u0db1\u0dca\u0db1\u0dad\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0d9c\u0dca\u200d\u0dbb\u0dd1\u0db8\u0dca 40\u0db1\u0dca \u0dc0\u0dba\u0dbd\u0dca 30,000\u0d9a\u0dca \u0dc3\u0dd0\u0db4\u0dba\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba",
    "url_metadata": "https://www.cabinetoffice.gov.lk/cab/index.php?option=com_content&view=article&id=16&Itemid=49&lang=si&dID=13396",
