    "description": "\u0d86\u0db4\u0daf\u0dcf \u0d85\u0dc0\u0daf\u0dcf\u0db1\u0db8\u0dca \u0d9a\u0dbd\u0dcf\u0db4\u0dc0\u0dbd \u0dc0\u0dd9\u0dc3\u0dd9\u0db1 \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0dd9\u0dbb\u0dc3\u0dc0\u0dd2 \u0d86\u0db4\u0daf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dad\u0dca\u200d\u0dba\u0dc3\u0dca\u0dae\u0dd2\u0dad\u0dd2\u0d9a \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8",
