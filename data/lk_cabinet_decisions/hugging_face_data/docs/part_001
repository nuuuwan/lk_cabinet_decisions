    "description": "\u0dba\u0dcf\u0db4\u0db1\u0dba \u0d9a\u0dd2\u0dbd\u0dd2\u0db1\u0ddc\u0da0\u0dca\u0da0\u0dd2\u0dba \u0da2\u0dbd\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0daf\u0db1 \u0dc3\u0dc4 \u0dc3\u0db1\u0dd3\u0db4\u0dcf\u0dbb\u0d9a\u0dca\u0dc2\u0d9a \u0dc0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba - \u0db4\u0dbd\u0dd9\u0dba\u0dd2, \u0d9a\u0ddc\u0da9\u0dd2\u0d9a\u0dcf\u0db8\u0db8\u0dca, \u0db1\u0dbd\u0dca\u0dbd\u0dd6\u0dbb\u0dca, \u0d9a\u0dbb\u0dd9\u0dba\u0dd2\u0db1\u0d9c\u0dbb\u0dca, \u0db4\u0dd4\u0db1\u0dca\u0d9c\u0dd4\u0da9\u0dd4\u0dad\u0dd2\u0dc0\u0dca, \u0d9a\u0dba\u0dd2\u0da7\u0dca\u0dc3\u0dca, \u0dc0\u0da9\u0dd4\u0d9a\u0dca\u0d9a\u0ddc\u0da9\u0dd9\u0dba\u0dd2 \u0dc3\u0dc4 \u0dba\u0dcf\u0db4\u0db1\u0dba \u0db8\u0dc4 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dc0 (\u0d95\u0dbd\u0dca\u0da9\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0d9a\u0dca) \u0dba\u0db1 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0dba\u0db1\u0dca\u0dc4\u0dd2 \u0da2\u0dbd \u0d9a\u0dd4\u0dbd\u0dd4\u0db1\u0dd4 \u0d89\u0daf\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8    (2 \u0dc0\u0db1 \u0db4\u0dd0\u0d9a\u0dda\u0da2\u0dba)",
