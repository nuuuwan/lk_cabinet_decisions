    "description": "\u0dbb\u0d9a\u0dca\u0dad\u0dc4\u0dd3\u0db1\u0dad\u0dcf\u0dc0\u0dba \u0dc3\u0dc4 \u0dbb\u0d9a\u0dca\u0dad\u0dc4\u0dd3\u0db1\u0dad\u0dcf\u0dc0\u0dba \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0d9c\u0dd0\u0da7\u0dbd\u0dd4 \u0d85\u0da9\u0dd4 \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dd4\u0dbd\u0db7\u0dc0 \u0db7\u0dcf\u0dc0\u0dd2\u0dad\u0dcf \u0d9a\u0dbb\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0d86\u0dc4\u0dcf\u0dbb \u0dba\u0d9a\u0da9 \u0dc3\u0dc4 \u0dc6\u0ddd\u0dbd\u0dd2\u0d9a\u0dca \u0d85\u0db8\u0dca\u0dbd\u0dba \u0dba\u0ddc\u0daf\u0dcf \u0dc3\u0db6\u0dbd\u0d9a\u0dbb\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8",
