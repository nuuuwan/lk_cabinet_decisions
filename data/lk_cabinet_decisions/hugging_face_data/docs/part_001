    "description": "\u0dc4\u0dd2\u0dba\u0dd4\u0db8\u0db1\u0dca \u0d87\u0dbd\u0dca\u0db6\u0dd2\u0dba\u0dd4\u0db8\u0dd2\u0db1\u0dca \u0dc3\u0ddc\u0dbd\u0dd2\u0dba\u0dd4\u0dc2\u0db1\u0dca \u0db6\u0dd3\u0db4\u0dd3 \u0dc4\u0ddd \u0db4\u0dd3\u0d91\u0da0\u0dca \u0d8a\u0dba\u0dd6\u0d86\u0dbb\u0dca 20% \u0db8\u0dd2\u0dbd\u0dd2\u0dbd\u0dd3\u0da7\u0dbb\u0dca 50 \u0db6\u0ddd\u0dad\u0dbd\u0dca 60,000\u0d9a\u0dca \u0dc3\u0dd0\u0db4\u0dba\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd6 \u0da7\u0dd9\u0db1\u0dca\u0da9\u0dbb\u0dba",
