    "description": "\u0db8\u0dbb\u0db3\u0d9c\u0dc4\u0db8\u0dd4\u0dbd \u0dc3\u0dc4\u0dbd\u0dca \u0d9c\u0db6\u0da9\u0dcf \u0dc3\u0d82\u0d9a\u0dd3\u0dbb\u0dca\u0dab\u0dba\u0da7 \u0d85\u0db1\u0dd4\u0db6\u0daf\u0dca\u0db0\u0dd2\u0dad \u0dc3\u0dc4\u0dbd\u0dca \u0dc0\u0dd2\u0d9a\u0dd2\u0dab\u0dd3\u0db8\u0dda \u0dc0\u0dd9\u0dc5\u0dd9\u0db3 \u0d9a\u0dd4\u0da7\u0dd2 \u0d89\u0daf\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8",
