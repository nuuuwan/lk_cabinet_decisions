    "num": "16",
    "date_str": "2019-09-17",
    "description": "\u0dc3\u0dd0\u0db8\u0da7 \u0dc3\u0dd9\u0dc0\u0dab \u0db1\u0dc0 \u0d86\u0daf\u0dbb\u0dca\u0dc1 \u0d9c\u0db8\u0dca\u0db8\u0dcf\u0db1 101\u0d9a\u0dca \u0db1\u0dd2\u0dc0\u0dcf\u0dc3\u0dbd\u0dcf\u0db7\u0dd3\u0db1\u0dca\u0d9c\u0dda \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba\u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0dbd\u0dd3\u0db8",
    "url_metadata": "https://www.cabinetoffice.gov.lk/cab/index.php?option=com_content&view=article&id=16&Itemid=49&lang=si&dID=10115",
    "lang": "si",
    "decision_details_title": "2019-09-17 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0db8\u0dab\u0dca\u0da9\u0dbd \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0db4\u0dd2\u0dbd\u0dd2\u0db6\u0db3 \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dc1\u0dba",
    "decision_details_body": "- 2015 \u0dc0\u0dc3\u0dbb\u0dd2\u0db1\u0dca \u0d87\u0dbb\u0db9\u0dd2 \u0dc3\u0dd0\u0db8\u0da7 \u0dc3\u0dd9\u0dc0\u0dab \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1\u0dda \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd4\u0d9b\u0dad\u0db8 \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0dc0\u0dd0\u0da9\u0db4\u0dd2\u0dc5\u0dd2\u0dc0\u0dd9\u0dc5\u0d9a\u0dca \u0dc0\u0db1\u0dd4\u0dba\u0dda \u0d86\u0daf\u0dbb\u0dca\u0dc1 \u0d9c\u0db8\u0dca\u0db8\u0dcf\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0daf\u0dcf\u0db8\u0dba\u0dba\u0dd2. \u0d91\u0d9a\u0dd3 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 \u0dba\u0da7\u0dad\u0dda \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0db8\u0dd4\u0dbd\u0dca \u0d9a\u0ddc\u0da7 \u0d9c\u0dad\u0dca \u0da2\u0db1\u0dcf\u0dc0\u0dcf\u0dc3\u0dba\u0d9a\u0da7 \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u0dc3\u0dd9\u0dc3\u0dd4 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dc3\u0dc4\u0dd2\u0dad\u0dc0 \u0db1\u0dd2\u0dc0\u0dcf\u0dc3\u0dbd\u0dcf\u0db7\u0dd3\u0db1\u0dca\u0d9c\u0dda \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba\u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0db6\u0dd6 \u0d86\u0daf\u0dbb\u0dca\u0dc1 \u0d9c\u0db8\u0dca\u0db8\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba 286\u0d9a\u0dca \u0dc0\u0db1 \u0d85\u0dad\u0dbb, \u0d92 \u0d85\u0dad\u0dd4\u0dbb\u0dd2\u0db1\u0dca \u0db1\u0dc0 \u0d86\u0daf\u0dbb\u0dca\u0dc1 \u0d9c\u0db8\u0dca\u0db8\u0dcf\u0db1 101\u0d9a\u0dca 2019 \u0dbd\u0ddd\u0d9a \u0da2\u0db1\u0dcf\u0dc0\u0dcf\u0dc3 \u0daf\u0dd2\u0db1\u0dba \u0dba\u0dd9\u0daf\u0dd3 \u0d87\u0dad\u0dd2 \u0d94\u0d9a\u0dca\u0dad\u0ddd\u0db6\u0dbb\u0dca \u0db8\u0dc3 07\u0dc0\u0db1 \u0daf\u0dd2\u0db1\u0da7 \u0db4\u0dd9\u0dbb \u0daf\u0dd9\u0dc3\u0dad\u0dd2\u0dba \u0dad\u0dd4\u0dc5, \u0d91\u0db1\u0db8\u0dca \u0dc3\u0dd0\u0db4\u0dca\u0dad\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 23 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0d94\u0d9a\u0dca\u0dad\u0ddd\u0db6\u0dbb\u0dca \u0db8\u0dc3 07\u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0dd6 \u0d9a\u0dcf\u0dbd\u0db4\u0dbb\u0dd2\u0da0\u0dca\u0da1\u0dda\u0daf\u0dba \u0dad\u0dd4\u0dc5\u0daf\u0dd3 \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d85\u0db4\u0dda\u0d9a\u0dca\u0dc2\u0dcf\u0dc0\u0dd9\u0db1\u0dca \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dcf\u0db7\u0dd3 \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0da7 \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0db8\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf \u0d9a\u0dbb\u0db1 \u0db6\u0dc0 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dda \u0daf\u0dd0\u0db1\u0d9c\u0dd0\u0db1\u0dd2\u0db8 \u0db4\u0dd2\u0dab\u0dd2\u0dc3 \u0db1\u0dd2\u0dc0\u0dcf\u0dc3, \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc3\u0dc4 \u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dd8\u0dad\u0dd2\u0d9a \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba\u0dad\u0dd4\u0db8\u0dcf \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0d9a\u0dbb\u0dd4\u0dab \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc3\u0dd0\u0dbd\u0d9a\u0dd2\u0dbd\u0dca\u0dbd\u0da7 \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0dbd\u0daf\u0dd3."
  },
