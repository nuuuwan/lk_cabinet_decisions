    "decision_details_title": "2013-08-15 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0db8\u0dab\u0dca\u0da9\u0dbd \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0db4\u0dd2\u0dbd\u0dd2\u0db6\u0db3 \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dc1\u0dba",
    "decision_details_body": "- \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0daf\u0db1 \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dbb\u0dca\u0daf\u0dda\u0dc1 \u0d9a\u0dc5 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0db8\u0dc4\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dd4\u0db1\u0dbb\u0dd4\u0dad\u0dca\u0dae\u0dcf\u0db4\u0db1/\u0db4\u0dd4\u0dc5\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8/\u0dc0\u0dd0\u0da9\u0dd2\u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dd2\u0dab\u0dd2\u0dc3 \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0ddc\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dcf\u0dad\u0dca\u0dad\u0dd4 \u0db4\u0dd2\u0dbb\u0dd2\u0db1\u0dd0\u0db8\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dbb\u0dcf\u0dba \u0dc4\u0dcf \u0db8\u0dc4\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0dc0\u0dc1\u0dba\u0dd9\u0db1\u0dca, \u0d85\u0dad\u0dd2\u0d9c\u0dbb\u0dd4 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dba\u0ddd\u0da2\u0db1\u0dcf\u0dc0, \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d85\u0db1\u0dd4\u0db8\u0dad \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3: *\t\u0dc4\u0dc3\u0dbd\u0d9a- \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0d9c\u0db8\u0dd4\u0dc0- \u0dc4\u0dd9\u0da7\u0dca\u0da7\u0dd2\u0db4\u0ddc\u0dbd \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba (\u0db6\u0dd3 484) \u0d9a\u0dd2.\u0db8\u0dd3.0.00 \u0dc3\u0dd2\u0da7 \u0d9a\u0dd2.\u0db8\u0dd3.20.00 \u0daf\u0d9a\u0dca\u0dc0\u0dcf;*\t\u0d9a\u0dd0\u0dbd\u0dab\u0dd2\u0db8\u0dd4\u0dbd\u0dca\u0dbd - \u0db8\u0dd4\u0dbd\u0dca\u0dbd\u0dda\u0dbb\u0dd2\u0dba\u0dcf\u0dc0 - \u0d9a\u0ddc\u0dc3\u0dca\u0dc0\u0dad\u0dca\u0dad \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba -\u0d85\u0daf\u0dd2\u0dba\u0dbb I - \u0d9a\u0dab\u0dd4\u0db8\u0dad \u0d89\u0daf\u0dd2\u0dc0\u0db1 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba \u0dc3\u0dc4 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dda\u0dc1 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba \u0d9a\u0dd2.\u0db8\u0dd3.0.00 \u0dc3\u0dd2\u0da7 \u0d9a\u0dd2.\u0db8\u0dd3.0.60 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8;*\t\u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd - \u0db1\u0dcf\u0dbb\u0db8\u0dca\u0db8\u0dbd - \u0db8\u0dcf\u0daf\u0db8\u0dca\u0db4\u0dda \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba \u0d9a\u0dd2.\u0db8\u0dd3.22.26 \u0dc3\u0dd2\u0da7 \u0d9a\u0dd2.\u0db8\u0dd3.40.87 \u0daf\u0d9a\u0dca\u0dc0\u0dcf;*\t\u0dc3\u0dd3\u0daf\u0dd6\u0dc0 - \u0d9a\u0da7\u0dd4\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba\u0dda \u0d9a\u0dd2.\u0db8\u0dd3.0.00 \u0dc3\u0dd2\u0da7 \u0d9a\u0dd2.\u0db8\u0dd3.3.90 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc3\u0dc4 \u0dc3\u0dd3\u0daf\u0dd6\u0dc0 \u0dc3\u0dd2\u0da7 \u0d8b\u0da9\u0dd4\u0d9c\u0db8\u0dca\u0db4\u0dbd \u0daf\u0d9a\u0dca\u0dc0\u0dcf  \u0d9a\u0dd2.\u0db8\u0dd3.0.00 \u0dc3\u0dd2\u0da7 \u0d9a\u0dd2.\u0db8\u0dd3.11.70 \u0daf\u0d9a\u0dca\u0dc0\u0dcf;  *\t\u0dba\u0dcf\u0db4\u0db1\u0dba \u200d- \u0db4\u0ddc\u0db1\u0dca\u0db1\u0dcf\u0dbd\u0dd9\u0dba\u0dd2 - \u0db4\u0dda\u0daf\u0dd4\u0dbb\u0dd4\u0dad\u0dd4\u0da9\u0dd4\u0dc0 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba\u0dda \u0d9a\u0dd2.\u0db8\u0dd3.28.5 \u0dc3\u0dd2\u0da7 \u0d9a\u0dd2.\u0db8\u0dd3.31.5 \u0d85\u0dad\u0dbb \u0d9a\u0dd2.\u0db8\u0dd3.1.5 \u0d9a \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9a\u0ddc\u0da7\u0dc3; \u0dc3\u0dc4*\t\u0d85\u0d9a\u0dd4\u0dbb\u0dda\u0d9c\u0ddc\u0da9 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0d9a \u0db8\u0dd6\u0dbd\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda \u0dc0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba \u0d86\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0dad \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0da2\u0dcf\u0dbd\u0dba."
  },
