    "description": "\u0db1\u0dda\u0db4\u0dcf\u0dbd\u0dba\u0dda \u0dbd\u0dd4\u0db8\u0dca\u0db6\u0dd2\u0dab\u0dd2 \u0db1\u0dd4\u0dc0\u0dbb \u0dc3\u0dca\u0dae\u0dcf\u0db4\u0dd2\u0dad \u0daf\u0dd4\u0da7\u0dd4\u0d9c\u0dd0\u0db8\u0dd4\u0dab\u0dd4 \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dc1\u0dcf\u0dbd\u0dcf\u0dc0",
