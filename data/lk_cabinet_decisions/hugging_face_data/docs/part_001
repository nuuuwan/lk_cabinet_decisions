    "description": "\u0d85\u0db1\u0dca\u0dad\u0d83\u0dc1\u0ddb\u0dbb\u0dd2\u0d9a \u0db7\u0dcf\u0dc0\u0dd2\u0dad\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd6 \u0dc4\u0dd2\u0dba\u0dd4\u0db8\u0db1\u0dca \u0d89\u0db8\u0dd2\u0dba\u0dd4\u0db1\u0ddc\u0d9c\u0dca\u0dbd\u0ddc\u0db6\u0dd2\u0dba\u0dd4\u0dbd\u0dd3\u0db1\u0dca \u0db6\u0dd3\u0db4\u0dd3, \u0d9c\u0dca\u200d\u0dbb\u0dd1\u0db8\u0dca 5\u20116 \u0dc0\u0dba\u0dbd\u0dca 120,000\u0d9a\u0dca \u0dc3\u0dd0\u0db4\u0dba\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba",
    "url_metadata": "https://www.cabinetoffice.gov.lk/cab/index.php?option=com_content&view=article&id=16&Itemid=49&lang=si&dID=13398",
