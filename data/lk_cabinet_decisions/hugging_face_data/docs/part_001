    "decision_details_title": "2014-12-04 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0db8\u0dab\u0dca\u0da9\u0dbd \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0db4\u0dd2\u0dbd\u0dd2\u0db6\u0db3 \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dc1\u0dba",
    "decision_details_body": "- \u0dbb\u0da7\u0dd9\u0dc4\u0dd2 \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0dc3\u0dc4 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0d9a\u0dd9\u0dbb\u0dd9\u0db1 \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9a\u0ddc\u0da7\u0dc3\u0dca \u0db4\u0dd4\u0db1\u0dbb\u0dd4\u0dad\u0dca\u0dae\u0dcf\u0db4\u0db1\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dc4\u0db3\u0dd4\u0db1\u0dcf\u0d9c\u0db1\u0dd4 \u0dbd\u0dd0\u0db6 \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dbb \u0db8\u0dd9\u0db8 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0dc0\u0dd0\u0da9\u0dd2\u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dd3\u0dba \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1 \u0dc0\u0dd9\u0dad \u0dc0\u0da9\u0dcf \u0dc4\u0ddc\u0db3 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dda\u0dc1 \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dc3\u0dd0\u0db4\u0dba\u0dd9\u0db1\u0dd4  \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dbb \u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dc4\u0dcf \u0da2\u0dcf\u0dad\u0dca\u200d\u0dba\u0db1\u0dca\u0dad\u0dbb \u0dc0\u0dd9\u0dc5\u0db3 \u200d\u0db4\u0ddc\u0dc5\u0dc0\u0dbd\u0dca \u0dc0\u0dd9\u0dad  \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1 \u0db8\u0db0\u0dca\u200d\u0dba\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0db1\u0dca\u0dc4\u0dd2 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dad\u0dcf\u0dc0 \u0db4\u0dd4\u0dc5\u0dd4\u0dbd\u0dca \u0dc0\u0db1\u0dd4 \u0d87\u0dad. \r\n\t*\t\u0d85\u0dba\u0d9c\u0db8 - \u0d9a\u0dd4\u0d9a\u0dd4\u0dbd\u0dda\u0d9c\u0db8 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba\t- \u0d9a\u0dd2.\u0db8\u0dd3.16.89;\r\n\t*\t\u0daf\u0dd2\u0d9a\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd - \u0da2\u0db1\u0dca\u0d9c\u0dd4\u0dbd\u0dca\u0dbd - \u0dad\u0dbd\u0dca\u0db4\u0dd2\u0da7\u0dd2\u0d9c\u0dbd \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba - \u0d9a\u0dd2.\u0db8\u0dd3.24.14;\r\n*\t\u0db6\u0dbd\u0d82\u0d9c\u0ddc\u0da9 - \u0db6\u0ddd\u0dc0\u0dad\u0dca\u0dad - \u0d9a\u0dbd\u0dca\u0dad\u0ddc\u0da7 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba - \u0d9a\u0dd2.\u0db8\u0dd3.28.96;\r\n*\t\u0db1\u0ddd\u0dbb\u0dca\u0dc0\u0dd4\u0da9\u0dca - \u0db6\u0ddc\u0d9c\u0dc0\u0db1\u0dca\u0dad\u0dbd\u0dcf\u0dc0 -\u0d9a\u0dd0\u0db8\u0dca\u0db4\u0dd2\u0dba\u0db1\u0dca \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba - \u0d9a\u0dd2.\u0db8\u0dd3.16.89;\r\n*\t\u0db4\u0dc3\u0dca\u0dc3\u0dbb - \u0dc4\u0dd2\u0d9f\u0dd4\u0dbb\u0dd4\u0d9a\u0da9\u0dd4\u0dc0 - \u0db4\u0dd0\u0dbd\u0dc0\u0dad\u0dca\u0dad \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba - \u0d9a\u0dd2.\u0db8\u0dd3.30.17; \u0dc3\u0dc4\r\n*\t\u0db6\u0dca\u0dbd\u0dd0\u0d9a\u0dca\u0db4\u0dd6\u0dbd\u0dca - \u0d85\u0db9\u0dda\u0dc0\u0dd9\u0dbd - \u0db4\u0da7\u0dca\u0da7\u0dd2\u0db4\u0ddc\u0dbd - \u0dc4\u0ddd\u0dbb\u0dca\u0da7\u0db1\u0dca\u0dad\u0dd0\u0db1\u0dca\u0db1 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba - \u0d9a\u0dd2.\u0db8\u0dd3.28.16\r\n\r\n\u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0daf\u0db1 \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc0\u0dda \u0db1\u0dd2\u0dbb\u0dca\u0daf\u0dda\u0dc1\u0dba \u0db4\u0dbb\u0dd2\u0daf\u0dd2, \u0d89\u0dc4\u0dad \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9a\u0ddc\u0da7\u0dc3\u0dca \u0db4\u0dd4\u0db1\u0dbb\u0dd4\u0dad\u0dca\u0dae\u0dcf\u0db4\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u0d9a\u0ddc\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dcf\u0dad\u0dca\u0dad\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dcf\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dd2\u0dab\u0dd2\u0dc3 \u0db8\u0dc4\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c, \u0dc0\u0dbb\u0dcf\u0dba \u0dc4\u0dcf \u0db1\u0dcf\u0dc0\u0dd2\u0d9a \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0dc0\u0dc1\u0dba\u0dd9\u0db1\u0dca \u0d85\u0dad\u0dd2\u0d9c\u0dbb\u0dd4 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dba\u0ddd\u0da2\u0db1\u0dcf\u0dc0 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d85\u0db1\u0dd4\u0db8\u0dad \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3."
  },
