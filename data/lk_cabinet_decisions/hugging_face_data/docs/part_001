    "description": "\u0db8\u0dcf\u0db1\u0dc0 \u0dc1\u0dcf\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4\u0dd3\u0da8\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0db8\u0dc4\u0dbd\u0dca \u0daf\u0dd9\u0d9a\u0d9a\u0dd2\u0db1\u0dca \u0dba\u0dd4\u0dad\u0dca \u0d9c\u0ddc\u0da9\u0db1\u0dd0\u0d9f\u0dd2\u0dbd\u0dca\u0dbd\u0d9a\u0dca \u0d89\u0daf\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 - \u0d9a\u0dd0\u0dbd\u0dab\u0dd2\u0dba \u0dc0\u0dd2\u0dc1\u0dca\u0dc0\u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0dbd\u0dba (\u0d9a\u0dda 20 \u0d9c\u0ddc\u0da9\u0db1\u0dd0\u0d9f\u0dd2\u0dbd\u0dca\u0dbd\u0dda III\u0dc0\u0dd9\u0db1\u0dd2 \u0d85\u0daf\u0dd2\u0dba\u0dbb)",
