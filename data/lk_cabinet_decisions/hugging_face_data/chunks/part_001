    "description": "\u0d8c\u0db1 \u0d8b\u0db4\u0dba\u0ddd\u0da2\u0dd2\u0dad \u0d89\u0da9\u0db8\u0dca/\u0daf\u0dda\u0db4\u0dc5 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dc3\u0dca\u0dad \u0d8b\u0db4\u0dba\u0ddd\u0da2\u0db1\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4 \u0d86\u0dba\u0ddd\u0da2\u0d9a\u0dba\u0db1\u0dca \u0dc0\u0dd9\u0dad \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0db8",
