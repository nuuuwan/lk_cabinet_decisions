    "description": "\u0db8\u0dd2\u0dbb\u0dd2\u0daf\u0dd2\u0dba \u0db8\u0dad\u0dca\u0dc3\u0dca\u200d\u0dba \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1 \u0d85\u0dc3\u0dca\u0dc0\u0db1\u0dd4 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dad\u0ddd\u0dbb\u0dcf \u0d9c\u0dad\u0dca \u0db1\u0dd2\u0dad\u0dca\u200d\u0dba \u0da2\u0dbd\u0dcf\u0dc1\u0dc0\u0dbd \u0db6\u0dcf\u0db0\u0d9a \u0daf\u0dd0\u0dbd\u0dca \u0dc3\u0dca\u0dae\u0dcf\u0db4\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8",
