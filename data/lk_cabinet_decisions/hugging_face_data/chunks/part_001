    "description": "\u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0dbd\u0ddc\u0dad\u0dbb\u0dd0\u0dba\u0dd2 \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc0\u0dd9\u0dad \u0dc0\u0dc3\u0dbb\u0d9a \u0d9a\u0dcf\u0dbd\u0dba\u0d9a\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0dbb\u0dd2\u0d9c\u0dab\u0d9a\u0dcf\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0dad \u0daf\u0dd2\u0db1\u0dd4\u0db8\u0dca \u0d87\u0daf\u0dd3\u0db8\u0dda \u0dbd\u0ddc\u0dad\u0dbb\u0dd0\u0dba\u0dd2\u0db4\u0dad\u0dca \u0db1\u0dd2\u0dbb\u0dca\u0db8\u0dcf\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8, \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8, \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dab\u0dba \u0dc3\u0dc4 \u0dc3\u0dd0\u0db4\u0dba\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba",
    "url_metadata": "https://www.cabinetoffice.gov.lk/cab/index.php?option=com_content&view=article&id=16&Itemid=49&lang=si&dID=13406",
    "lang": "si",
    "decision_details_title": "2025-09-08 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0db8\u0dab\u0dca\u0da9\u0dbd \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0db4\u0dd2\u0dbd\u0dd2\u0db6\u0db3 \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dc1\u0dba (\u0db8\u0dd3\u0dbd\u0d9c \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8\u0dda\u0daf\u0dd3 \u0dc3\u0db8\u0dca\u0db8\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0)",
    "decision_details_body": "- \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0dbd\u0ddc\u0dad\u0dbb\u0dd0\u0dba\u0dd2 \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db4\u0dbb\u0dd2\u0d9c\u0dab\u0d9a\u0dcf\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0dad\u0dc0 \u0daf\u0dd2\u0db1\u0dd4\u0db8\u0dca \u0d85\u0daf\u0dd2\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dbd\u0d9c\u0dca\u0db1 \u0dc0\u0dcf\u0dc3\u0db1\u0dcf\u0dc0, \u0d9a\u0db4\u0dca\u0dbb\u0dd4\u0d9a, \u0d85\u0daf \u0d9a\u0ddd\u0da7\u0dd2\u0db4\u0dad\u0dd2, \u0dc3\u0dd4\u0db4\u0dbb\u0dca \u0db6\u0ddd\u0dbd\u0dca, \u0dc3\u0dc3\u0dd2\u0dbb\u0dd2, \u0dc1\u0db1\u0dd2\u0daf\u0dcf, \u0dc3\u0dd4\u0db4\u0dd2\u0dbb\u0dd2 \u0db0\u0db1 \u0dc3\u0db8\u0dca\u0db4\u0dad \u0dbd\u0ddc\u0dad\u0dbb\u0dd0\u0dba\u0dd2\u0db4\u0dad\u0dca \u0dc3\u0dc4 \u0db1\u0dc0 \u0daf\u0dd2\u0db1\u0dd4\u0db8\u0dca \u0d87\u0daf\u0dd3\u0db8\u0dda \u0dbd\u0ddc\u0dad\u0dbb\u0dd0\u0dba\u0dd2 \u0d85\u0d82\u0d9a 01 (\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dad) \u0dc4\u0dcf\u00a0 \u0db1\u0dc0 \u0daf\u0dd2\u0db1\u0dd4\u0db8\u0dca \u0d87\u0daf\u0dd3\u0db8\u0dda \u0dbd\u0ddc\u0dad\u0dbb\u0dd0\u0dba\u0dd2 \u0d85\u0d82\u0d9a 02 \u0dba\u0db1 \u0dbd\u0ddc\u0dad\u0dbb\u0dd0\u0dba\u0dd2 \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0d9a \u0d9a\u0dcf\u0dbd\u0dba\u0d9a\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0db1\u0dd2\u0dbb\u0dca\u0db8\u0dcf\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8, \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8, \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dab\u0dba \u0dc3\u0dc4 \u0dc3\u0dd0\u0db4\u0dba\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dd2\u0dab\u0dd2\u0dc3 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dad\u0dbb\u0d9c\u0d9a\u0dcf\u0dbb\u0dd3 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc0\u0dda\u0daf\u0dba \u0dba\u0da7\u0dad\u0dda \u0dbd\u0d82\u0dc3\u0dd4 \u0d9a\u0dd0\u0db3\u0dc0\u0dcf \u0d87\u0dad. \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0dbd\u0d82\u0dc3\u0dd4 07\u0d9a\u0dca \u0dbd\u0dd0\u0db6\u0dd3 \u0dad\u0dd2\u0db6\u0dda. \u0d92 \u0d85\u0db1\u0dd4\u0dc0, \u0d89\u0dc4\u0dc5 \u0db8\u0da7\u0dca\u0da7\u0db8\u0dda \u0db4\u0dca\u200d\u0dbb\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0daf\u0db1 \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc0\u0dda \u0db1\u0dd2\u0dbb\u0dca\u0daf\u0dda\u0dc1\u0dba \u0db8\u0dad \u0db4\u0daf\u0db1\u0db8\u0dca\u0dc0 \u0dc3\u0dcf\u0dbb\u0dcf\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0da0\u0dcf\u0dbb \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0d87\u0dad\u0dd2 \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d85\u0dc0\u0db8 \u0dbd\u0d82\u0dc3\u0dd4\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dc0\u0dd9\u0dad \u0d85\u0daf\u0dcf\u0dc5 \u0db4\u0dca\u200d\u0dbb\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba\u0db1\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0db1\u0dd0\u0db8\u0dd3\u0db8 \u0db4\u0dd2\u0dab\u0dd2\u0dc3 \u0db8\u0dd4\u0daf\u0dbd\u0dca, \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0daf\u0db1 \u0dc3\u0dc4 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0dc0\u0dc1\u0dba\u0dd9\u0db1\u0dca \u0d9c\u0dbb\u0dd4 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dc5 \u0dba\u0ddd\u0da2\u0db1\u0dcf\u0dc0 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d85\u0db1\u0dd4\u0db8\u0dad \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3.\u0dbd\u0d82\u0dc3\u0dd4\u0d9a\u0dbb\u0dd4\u0d9c\u0dda \u0db1\u0db8\u0dbd\u0ddc\u0dad\u0dbb\u0dd0\u0dba\u0dd2 \u0dc3\u0db1\u0dca\u0db1\u0dcf\u0db8\u0dbaToppan Forms (Colombo) Ltd\u0dbd\u0d9c\u0dca\u0db1 \u0dc0\u0dcf\u0dc3\u0db1\u0dcf\u0dc0 \u0dc3\u0dc4 \u0d9a\u0db4\u0dca\u0dbb\u0dd4\u0d9aDPJ Holdings (Pvt) Ltd\u0d85\u0daf \u0d9a\u0ddd\u0da7\u0dd2\u0db4\u0dad\u0dd2, \u0dc3\u0dd4\u0db4\u0dbb\u0dca\u0db6\u0ddd\u0dbd\u0dca, \u0dc1\u0db1\u0dd2\u0