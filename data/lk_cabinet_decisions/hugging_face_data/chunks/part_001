    "description": "\u0db8\u0dd2\u0db1\u0dca\u0db1\u0dda\u0dbb\u0dd2\u0dba, \u0d9c\u0dd2\u0dbb\u0dd2\u0dad\u0dbd\u0dda, \u0d9c\u0dbd\u0dca\u0d94\u0dba, \u0dc4\u0dd4\u0dbb\u0dd4\u0dc5\u0dd4\u0dc0\u0dd0\u0dc0 \u0dc3\u0dc4 \u0dbb\u0dcf\u0da2\u0dcf\u0d82\u0d9c\u0db1\u0dba \u0dc0\u0dcf\u0dbb\u0dd2 \u0dba\u0ddd\u0da2\u0db1\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda \u0dc0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba",
