    "description": "\u0dbb\u0da2\u0dba\u0da7 \u0d85\u0dba\u0dad\u0dca \u0dc3\u0dc4\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dca\u200d\u0dba \u0dc4\u0dcf \u0dc3\u0dc4\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dca\u200d\u0dba \u0db1\u0ddc\u0dc0\u0db1 \u0daf\u0dda\u0db4\u0dc5\u0dc0\u0dbd \u0daf\u0dd3\u0dbb\u0dca\u0d9d\u0d9a\u0dcf\u0dbd\u0dd3\u0db1\u0dc0 \u0dc0\u0dcf\u0dc3\u0dba \u0d9a\u0dbb\u0db1 \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dc0\u0dd9\u0dad \u0d92\u0dc0\u0dcf\u0dba\u0dda \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0db4\u0dd0\u0dc0\u0dbb\u0dd3\u0db8",
