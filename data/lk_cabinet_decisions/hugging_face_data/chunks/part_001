    "chunk_id": "2024-06-03-002-en-0001",
    "chunk_index": 1,
    "language": "en",
    "md5": "0bd913642ced49179924f59e225eefca",
    "chunk_size_bytes": 169,
    "chunk_text": "Implementation of the Article 6 of the Paris Agreement in Sri Lanka\n\nPress briefing of Cabinet Decision taken on 2024-06-03 (Subject to Confirmation at the next Meeting)"
  },
