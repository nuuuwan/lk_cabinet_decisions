    "description": "\u0db6\u0dba\u0dd2\u0dc6\u0dda\u0dc3\u0dd2\u0d9a\u0dca \u0d85\u0dba\u0dd2\u0dc3\u0ddd\u0dc6\u0dda\u0db1\u0dca \u0d89\u0db1\u0dca\u0dc3\u0dd2\u0dba\u0dd4\u0dbd\u0dd2\u0db1\u0dca \u0d91\u0db1\u0dca\u0db1\u0dad\u0dca (\u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca) 30% \u0daf\u0dca\u200d\u0dbb\u0dcf\u0dc0\u0dca\u200d\u0dba 70% \u0d85\u0dba\u0dd2\u0dc3\u0ddd\u0dc6\u0dda\u0db1\u0dca \u0dc0\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 2.2\u0d9a\u0dca \u0dc3\u0dd0\u0db4\u0dba\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd6 \u0db4\u0dca\u200d\u0dbb\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba",
