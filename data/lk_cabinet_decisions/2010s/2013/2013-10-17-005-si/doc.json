  "doc_type": "lk_cabinet_decisions",
  "doc_id": "2013-10-17-005-si",
  "num": "5",
  "date_str": "2013-10-17",
  "description": "\u0daf\u0dda\u0dc1\u0dd3\u0dba/\u0dc0\u0dd2\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9a\u0ddc\u0da7\u0dc3\u0dca \u0db4\u0dd4\u0db1\u0dbb\u0dd4\u0dad\u0dca\u0dae\u0dcf\u0db4\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8",
  "url_metadata": "https://www.cabinetoffice.gov.lk/cab/index.php?option=com_content&view=article&id=16&Itemid=49&lang=si&dID=5257",
  "lang": "si",
  "decision_details_title": "2013-10-17 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0db8\u0dab\u0dca\u0da9\u0dbd \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0db4\u0dd2\u0dbd\u0dd2\u0db6\u0db3 \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dc1\u0dba",
  "decision_details_body": "- \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d92 \u0d92 \u0db4\u0dca\u200d\u0dbb\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0daf\u0db1 \u0d9a\u0db8\u0dd2\u0da7\u0dd4 \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db1\u0dd2\u0dbb\u0dca\u0daf\u0dda\u0dc1 \u0db4\u0daf\u0db1\u0db8\u0dca \u0d9a\u0dbb \u0d9c\u0dd9\u0db1 \u0db8\u0dc4\u0dcf \u0db7\u0dcf\u0dab\u0dca\u0da9\u0dcf\u0d9c\u0dcf\u0dbb\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0db1\u0dd2\u0dba\u0db8\u0dba\u0db1\u0dca\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 \u0daf\u0dda\u0dc1\u0dd3\u0dba/\u0dc0\u0dd2\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9a\u0ddc\u0da7\u0dc3\u0dca \u0db4\u0dd4\u0db1\u0dbb\u0dd4\u0dad\u0dca\u0dae\u0dcf\u0db4\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dd9\u0db1\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dd2\u0dab\u0dd2\u0dc3 \u0dc0\u0dbb\u0dcf\u0dba \u0dc4\u0dcf \u0db8\u0dc4\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0dc0\u0dc1\u0dba\u0dd9\u0db1\u0dca \u0d85\u0dad\u0dd2\u0d9c\u0dbb\u0dd4 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dba\u0ddd\u0da2\u0db1\u0dcf \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d85\u0db1\u0dd4\u0db8\u0dad \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3:\n\n\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0db6\u0dd0\u0d82\u0d9a\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc3\u0db4\u0dba\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0daf\u0dda\u0dc1\u0dd3\u0dba \u0d9a\u0ddc\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dcf\u0dad\u0dca\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dba\u0ddc\u0daf\u0dc0\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1\u0dca - \n* \u0d85\u0db9\u0dda\u0db4\u0dd4\u0dc3\u0dca\u0dc3 - \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd - \u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dd4\u0dab\u0dcf\u0db8\u0dbd\u0dba (\u0d926) \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba\u0dda \u0d9c\u0dbd\u0dca\u0dc0\u0dd9\u0dbd \u0dc3\u0dd2\u0da7 \u0daf\u0db9\u0dd4\u0dbd\u0dca\u0dbd \u0daf\u0d9a\u0dca\u0dc0\u0dcf (\u0d9a\u0dd2.\u0db8\u0dd3. 14)\n* \u0dc0\u0dad\u0dca\u0dad\u0dbd - \u0db8\u0dc4\u0dbb \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba (\u0db6\u0dd3 460) (\u0d9a\u0dd2.\u0db8\u0dd3. 0 - 7.24)\n* \u0dc0\u0dbb\u0d9a\u0dcf\u0db4\u0ddc\u0dc5 - \u0d85\u0d9f\u0dd4\u0dbb\u0dd4\u0dc0\u0dd0\u0dbd\u0dca\u0dbd - \u0d9a\u0dbb\u0dc0\u0db1\u0dd0\u0dbd\u0dca\u0dbd \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba (\u0db6\u0dd3 499) (\u0d9a\u0dd2.\u0db8\u0dd3. 0 - 12.50)\n* \u0d9a\u0dd2\u0dbb\u0dd2\u0db1\u0dca\u0daf - \u0db4\u0dbd\u0da7\u0dd4\u0db4\u0dcf\u0db1 - \u0dba\u0dcf\u0dbd \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba (\u0db6\u0dd3499) (\u0d9a\u0dd2.\u0db8\u0dd3. 0- 12.50) \n* \u0db4\u0dc3\u0dca\u0dc3\u0dbb - \u0db8\u0ddc\u0db1\u0dbb\u0dcf\u0d9c\u0dbd \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba (\u0d92 22) (\u0d9a\u0dd2.\u0db8\u0dd3. 0 - 27.0)\n* \u0dad\u0dbd\u0dca\u0daf\u0dd6\u0dc0 - \u0db8\u0dd3\u0dc0\u0dd2\u0da7\u0dd2\u0d9c\u0db8\u0dca\u0db8\u0db1 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba (\u0db6\u0dd3 408) (\u0d9a\u0dd2.\u0db8\u0dd3. 0 - 17.30)\n* \u0dad\u0dbd\u0dca\u0d9c\u0ddc\u0da9\u0db4\u0dd2\u0da7\u0dd2\u0dba - \u0dba\u0da7\u0dc0\u0dad\u0dca\u0dad - \u0daf\u0ddc\u0db9\u0dc0\u0dd9\u0dbd \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba (\u0db6\u0dd3 409) (\u0d9a\u0dd2.\u0db8\u0dd3. 0 - 26.40)\n* \u0db4\u0ddc\u0dc5\u0ddc\u0db1\u0dca\u0db1\u0dbb\u0dd4\u0dc0 - \u0dc4\u0dd2\u0d9f\u0dd4\u0dbb\u0d9a\u0dca\u0d9c\u0ddc\u0da9 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba (\u0db6\u0dd3 552) (\u0d9a\u0dd2.\u0db8\u0dd3. 2.0 - 13.65)\n* \u0db1\u0dcf\u0dbb\u0db8\u0dca\u0db8\u0dbd - \u0daf\u0d82\u0d9a\u0ddc\u0da7\u0dd4\u0dc0 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba (\u0db6\u0dd3 308) (\u0d9a\u0dd2.\u0db8\u0dd3. 16.03 - 45.25)\n\u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u0dc3\u0dde\u0daf\u0dd2 \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dbd \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dc3\u0db4\u0dba\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba - \n\n* \u0d9a\u0ddc\u0dc5\u0db9 - \u0db8\u0dc4\u0db1\u0dd4\u0dc0\u0dbb (\u0d921) \u0db8\u0dc4\u0dcf \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba\u0dda \u0db4\u0dd1\u0dbd\u0dd2\u0dba\u0d9c\u0ddc\u0da9 \u0dc3\u0dd2\u0da7 \u0d9a\u0dd2\u0dbb\u0dd2\u0db6\u0dad\u0dca\u0d9c\u0ddc\u0da9 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0dd6 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9a\u0ddc\u0da7\u0dc3 (\u0d9a\u0dd2.\u0db8\u0dd3. 5.86 - 13.10)\n* \u0d9a\u0ddc\u0dc5\u0db9 - \u0db8\u0dc4\u0db1\u0dd4\u0dc0\u0dbb (\u0d921) \u0db8\u0dc4\u0dcf \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba\u0dda \u0db4\u0dd1\u0dbd\u0dd2\u0dba\u0d9c\u0ddc\u0da9 \u0dc3\u0dd2\u0da7 \u0d9a\u0dd2\u0dbb\u0dd2\u0db6\u0dad\u0dca\u0d9c\u0ddc\u0da9 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0dd6 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9a\u0ddc\u0da7\u0dc3 (\u0d9a\u0dd2.\u0db8\u0dd3. 5.86 - 13.10)\n\"\u0db1\u0dd0\u200d\u0d9f\u0dd9\u0db1\u0dc4\u0dd2\u0dbb \u0db1\u0dc0\u0ddd\u0daf\u0dba\" \u0d9a\u0da9\u0dd2\u0db1\u0db8\u0dca \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 \u0dba\u0da7\u0dad\u0dda \u0db1\u0dd0\u200d\u200d\u0d9f\u0dd9\u0db1\u0dc4\u0dd2\u0dbb \u0db4\u0dc5\u0dcf\u0dad\u0dda \u0dc4\u0ddd \u0db1\u0dd0\u200d\u0d9f\u0dd9\u0db1\u0dc4\u0dd2\u0dbb \u0db4\u0dc5\u0dcf\u0dad\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dda\u0dc1 \u0dc0\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd6 \u0d9a\u0dd2.\u0db8\u0dd3. 153.67\u0d9a \u0db8\u0dd4\u0dc5\u0dd4 \u0daf\u0dd2\u0d9c\u0dd2\u0db1\u0dca \u0dba\u0dd4\u0dad\u0dca \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0dc4\u0dad\u0d9a (07) \u0d9a\u0ddc\u0da7\u0dc3\u0dca -\n* \u0d92 17 - \u0d9c\u0dcf\u0dbd\u0dca\u0dbd - \u0daf\u0dd9\u0db1\u0dd2\u0dba\u0dcf\u0dba - \u0db4\u0dd0\u0dbd\u0dca\u0db8\u0da9\u0dd4\u0dbd\u0dca\u0dbd \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba (\u0daf\u0dd9\u0db1\u0dd2\u0dba\u0dcf\u0dba \u0dc3\u0dd2\u0da7 \u0db8\u0dcf\u0daf\u0db8\u0dca\u0db4\u0dd9 \u0daf\u0d9a\u0dca\u0dc0\u0dcf) - \u0d9a\u0dd2.\u0db8\u0dd3. 51.90 \n* \u0d92 27 - \u0d85\u0db8\u0dca\u0db4\u0dcf\u0dbb - \u0d8b\u0dc4\u0db1 - \u0db8\u0dc4\u200d\u0d94\u0dba \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba - \u0d9a\u0dd2.\u0db8\u0dd3. 27.83 \n* \u0db6\u0dd3 73 - \u0daf\u0da9\u0dba\u0db1\u0dca\u0dad\u0dbd\u0dcf\u0dc0 - \u0d8b\u0dc4\u0db1 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba \u0d9a\u0dd2.\u0db8\u0dd3. 24.79\n* \u0db6\u0dd3 77 - \u0da0\u0dc0\u0dbd\u0d9a\u0da9\u0dda - \u0daf\u0da9\u0dba\u0db1\u0dca\u0dad\u0dbd\u0dcf\u0dc0 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba \n* \u0db6\u0dd3 187 - \u0d9a\u0dbd\u0dca\u0db8\u0dd4\u0db1\u0dda - \u0da0\u0dc0\u0dbd\u0d9a\u0da9\u0dda \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba\n* \u0db6\u0dd3 502 - \u0db8\u0db1\u0db8\u0dca\u0db4\u0dd2\u0da7\u0dd2\u0dba - \u0d85\u0dbb\u0dbd\u0d9c\u0db1\u0dca\u0dc0\u0dd2\u0dbd - \u0db8\u0dcf\u0daf\u0dd4\u0dbb\u0dd4\u0d94\u0dba \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba - \u0d9a\u0dd2.\u0db8\u0dd3. 30.00\n* \u0db6\u0dd3 1 - \u0d85\u0d9a\u0dca\u0d9a\u0dbb\u0dd9\u0dba\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd4 - \u0dc0\u0dbb\u0dd2\u0db4\u0dad\u0db1\u0dca\u0da0\u0dda\u0db1\u0dba\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba - \u0d9a\u0dd2.\u0db8\u0dd3. 19.15\n\u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u0d94\u0db4\u0dd9\u0